// Offline retrieval evaluation: hit@1, hit@3 and MRR for lexical (BM25), dense (cosine) and hybrid (RRF),
// plus a refusal test for questions the knowledge base cannot answer. Run: npm run eval

import { readFileSync, writeFileSync } from 'node:fs';
import { env, pipeline } from '@huggingface/transformers';
import { composeAnswer } from '../src/ai/extractive.ts';
import { bm25Rank, cosineRank, rrf, type IndexChunk } from '../src/ai/retrieve.ts';

const QUERY_PREFIX = 'Represent this sentence for searching relevant passages: ';

const CASES: { q: string; expect: string[] }[] = [
  { q: 'Who is Sohom?', expect: ['profile'] },
  { q: 'What is Project Apex DB?', expect: ['project-project-apex'] },
  { q: 'What does Lumeo do?', expect: ['project-lumeo', 'exp-lumeo'] },
  { q: 'What did he do at Deloitte?', expect: ['exp-deloitte'] },
  { q: 'Where does he study?', expect: ['exp-snu', 'profile'] },
  { q: 'Does he know Rust?', expect: ['skills-Languages', 'project-project-apex', 'exp-lumeo'] },
  { q: 'OCR and document processing experience', expect: ['exp-deloitte'] },
  { q: 'Which open source projects has he contributed to?', expect: ['oss-graphify', 'oss-inspect-ai'] },
  { q: 'What did he fix in Graphify?', expect: ['oss-graphify'] },
  { q: 'What did he fix in Inspect AI?', expect: ['oss-inspect-ai'] },
  { q: 'What is AETHER AI?', expect: ['project-aether-ai'] },
  { q: 'Explainable AI for plant disease', expect: ['project-xai-plant-disease'] },
  { q: 'Facial authentication with anti-spoofing', expect: ['project-zelda'] },
  { q: 'Multimodal emotion detection', expect: ['project-serene-mind'] },
  { q: 'What was his HackQuest internship?', expect: ['exp-hackquest'] },
  { q: 'How many waitlist signups does Lumeo have?', expect: ['exp-lumeo', 'project-lumeo'] },
  { q: 'multi-agent treasury and risk automation', expect: ['project-autofi'] },
  { q: 'AI smart contract auditor', expect: ['project-dacap'] },
  { q: 'framework for coordination of LLM coding agents', expect: ['project-causalmesh'] },
  { q: 'Which databases and queues does he use?', expect: ['skills-Backend / data', 'project-lumeo', 'exp-lumeo'] },
];

const REFUSALS = ['Has he worked at Amazon?', 'What is his salary expectation?', 'Does he have a PhD?', 'Has he worked at Meta?', 'What is his favourite food?'];

function score(rankings: string[][]): { hit1: number; hit3: number; mrr: number } {
  let hit1 = 0;
  let hit3 = 0;
  let mrr = 0;
  rankings.forEach((ids, i) => {
    const rank = ids.findIndex((id) => CASES[i].expect.includes(id));
    if (rank === 0) hit1 += 1;
    if (rank >= 0 && rank < 3) hit3 += 1;
    if (rank >= 0) mrr += 1 / (rank + 1);
  });
  const n = rankings.length;
  return { hit1: hit1 / n, hit3: hit3 / n, mrr: mrr / n };
}

async function main(): Promise<void> {
  const index = JSON.parse(readFileSync('public/rag/index.json', 'utf8')) as { model: string; chunks: (IndexChunk & { text: string })[] };
  const chunks = index.chunks;
  env.allowRemoteModels = false;
  env.localModelPath = new URL('../models/', import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, '$1');
  const extract = await (pipeline as unknown as (t: string, m: string, o: object) => Promise<(x: string, o: object) => Promise<{ data: Float32Array }>>)('feature-extraction', index.model, { dtype: 'q8' });

  const lexical: string[][] = [];
  const dense: string[][] = [];
  const hybrid: string[][] = [];
  for (const { q } of CASES) {
    const vec = Array.from((await extract(QUERY_PREFIX + q, { pooling: 'cls', normalize: true })).data);
    const bm = bm25Rank(chunks, q);
    const cos = cosineRank(chunks, vec);
    lexical.push(bm.map((r) => r.chunk.id));
    dense.push(cos.map((r) => r.chunk.id));
    hybrid.push(rrf([bm, cos], 10).map((h) => h.id));
  }
  const results = { 'BM25 (lexical)': score(lexical), 'bge-small cosine (dense)': score(dense), 'Hybrid (RRF)': score(hybrid) };

  let refused = 0;
  for (const q of REFUSALS) {
    const hits = bm25Rank(chunks, q).slice(0, 5).map((r) => ({ id: r.chunk.id, title: r.chunk.title, text: r.chunk.text, url: r.chunk.source_url, type: r.chunk.source_type, score: r.score }));
    if (composeAnswer(q, hits).refused) refused += 1;
  }

  const pct = (x: number): string => `${(x * 100).toFixed(0)}%`;
  const rows = Object.entries(results).map(([name, r]) => `| ${name} | ${pct(r.hit1)} | ${pct(r.hit3)} | ${r.mrr.toFixed(3)} |`);
  const report = [
    '# Retrieval evaluation',
    '',
    `Knowledge base: ${chunks.length} chunks, embedded with \`${index.model}\` (384-d). ${CASES.length} labelled questions. Generated by \`npm run eval\`.`,
    '',
    '| Retriever | hit@1 | hit@3 | MRR |',
    '|---|---|---|---|',
    ...rows,
    '',
    `Refusal test (extractive composer must decline when the sources do not say it): ${refused}/${REFUSALS.length} declined.`,
    '',
    'Small, hand-labelled set over a small corpus: useful for regressions, not a benchmark.',
    '',
  ].join('\n');
  writeFileSync('docs/ai-eval.md', report);
  console.log(report);
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
