# Public bucket holding bge-small-en-v1.5 and SmolLM2-360M-Instruct (Neon storage, public_read). Browser-side.
VITE_MODELS_BASE_URL=https://<branch>.storage.<region>.aws.neon.tech/slm-models

# Server-side only (Vercel env var + .env.local for `npm run ingest`). Never expose in client code.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

