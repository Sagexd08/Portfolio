{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!api/|assets/|brand/|gallery/|rag/|logos/|favicon|robots|sitemap|Resume).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/rag/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/gallery/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] }
  ]
}
